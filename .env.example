# Copy to .env and fill in. Never commit .env.

# --- Speech to text -----------------------------------------------------
# Groq hosts whisper-large-v3-turbo on a free tier. Primary ASR.
GROQ_API_KEY=
ASR_PROVIDER=groq                 # groq | local
ASR_MODEL=whisper-large-v3-turbo
ASR_LOCAL_MODEL=small             # faster-whisper size used when ASR_PROVIDER=local
ASR_DEVICE=cuda                   # cuda | cpu

# --- Language model -----------------------------------------------------
LLM_PROVIDER=groq                 # groq | gemini
LLM_MODEL=llama-3.3-70b-versatile
# Fallback provider, used automatically when the primary rate-limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Text to speech -----------------------------------------------------
# edge-tts needs no key and carries native fil-PH and id-ID voices.
TTS_PROVIDER=edge                 # edge | elevenlabs
ELEVENLABS_API_KEY=

# --- Retrieval ----------------------------------------------------------
# Embeddings run locally, so retrieval never depends on a rate-limited API.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_MULTILINGUAL=BAAI/bge-m3
EMBED_DEVICE=cuda
KB_PATH=kb.sqlite
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35          # below this the agent says it does not know

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
