# Copy to .env and fill in. Never commit .env.

# --- Speech to text -----------------------------------------------------
# Groq hosts whisper-large-v3-turbo on a free tier. Primary ASR.
GROQ_API_KEY=
ASR_PROVIDER=groq                 # groq | local
ASR_MODEL=whisper-large-v3-turbo
# faster-whisper size for the local fallback. It runs on CPU: the local path
# is a fallback rather than the hot path, and a GPU build additionally needs
# cuDNN for no measurable gain at a real-time factor of 0.4.
ASR_LOCAL_MODEL=small

# --- Language model -----------------------------------------------------
LLM_PROVIDER=groq                 # groq | gemini
LLM_MODEL=llama-3.3-70b-versatile
# Fallback provider, used automatically when the primary rate-limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Text to speech -----------------------------------------------------
# edge-tts needs no key and carries native fil-PH and id-ID voices.
TTS_PROVIDER=edge                 # edge | elevenlabs
ELEVENLABS_API_KEY=

# --- Retrieval ----------------------------------------------------------
# Embeddings run locally, so retrieval never depends on a rate-limited API.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL_MULTILINGUAL=BAAI/bge-m3
# Falls back to CPU automatically when no GPU is present.
EMBED_DEVICE=cuda
KB_PATH=kb.sqlite
RETRIEVAL_TOP_K=6

# Below this cosine similarity the retriever returns nothing and the agent says
# it does not know. Calibrated by scripts/calibrate_threshold.py over 34 labelled
# queries: 0.64 refuses no answerable question while rejecting 10 of 14
# out-of-scope ones. The remainder are caught by grounded generation, which is
# instructed to answer only from retrieved records.
RETRIEVAL_MIN_SCORE=0.64

# Optional cross-encoder reranking. Off by default: measured to improve ranking
# for well-formed questions but to score conversational utterances such as
# "this is too expensive" near zero, which is how callers actually speak.
RETRIEVAL_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
